  "verdicts": {
    "openplanter": {
      "capability": "Research Brain / Investigation Planning & Entity Resolution",
      "verdict": "COMPLEMENT ARGUS",
      "rationale": "OpenPlanter slightly improved entity precision (16.1% vs 13.5%, +2.6%) by executing focused recursive subtasks with lower query spam (6.4 vs 12.4 searches/task). However, it regressed evidence correctness (91.9% vs 92.5%) and introduced a new EVIDENCE_ALIGNMENT_FAILURE due to lack of domain-tailored facility fan-out. It should not replace Argus ResearchBrain, but its recursive acceptance-criteria planning can complement Argus for unstructured exploratory OSINT."
    },
    "photon": {
      "capability": "Discovery / Web Crawling",
      "verdict": "REJECT CHALLENGER",
      "rationale": "Photon failed to improve discovery recall (stuck at 71.2%) and regressed entity precision (13.0% vs 13.5%, -0.5%) and entity F1 (22.0% vs 22.7%). Photon's regex-based link harvesting indiscriminately spiders URLs without relevance ranking or semantic query understanding, pulling irrelevant pages. Crucially, Photon carries a restrictive GPL-3.0 copyleft license, creating an unacceptable licensing barrier for Heimdallr proprietary integration. Rejected."
    },
    "firecrawl": {
      "capability": "Acquisition / Document Extraction",
      "verdict": "KEEP ARGUS",
      "rationale": "Firecrawl produced identical composite scores (80.5%) and pass rates (45.5%) without moving entity precision or recall. However, its Markdown conversion stripped HTML layout and whitespace, causing slight regressions in evidence correctness on missing-information (90% vs 100%) and leadership research tasks (88.9% vs 91.7%). Furthermore, self-hosting full open-source Firecrawl requires Redis, Playwright/Puppeteer workers, BullMQ queues, and carries an AGPL-3.0 license, introducing immense infrastructure overhead for zero measured gain over Argus's built-in fetcher/extractor."
    },
    "combined_challenger_stack": {
      "capability": "Combined Challenger Stack (OpenPlanter + Photon + Firecrawl)",
      "verdict": "REJECT CHALLENGER",
      "rationale": "The combined challenger stack caused a catastrophic collapse in benchmark performance: task pass rate collapsed from 45.5% to 9.1% (only 1 passed), entity precision fell to 9.1%, entity recall collapsed from 71.2% to 9.1%, and discovery failures surged from 4 to 10. The three challengers compounded each other's blind spots: OpenPlanter generated non-domain queries, Photon crawled random links without semantic ranking, and Firecrawl stripped structural anchors, leaving downstream Argus workers with empty or irrelevant content."
    }
  }
}