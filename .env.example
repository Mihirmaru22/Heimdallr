# Copy to .env and replace every value marked CHANGE-ME. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=CHANGE-ME-postgres-superuser-password
# Letters, digits, - and _ only (it is placed in a SQL statement and a URL).
WEBDATA_DB_PASSWORD=CHANGE-ME-app-database-password

# Secret for the local SearXNG search container (any long random string).
SEARXNG_SECRET=CHANGE-ME-searxng-secret
# Docker Compose sets the SearXNG URL itself. Running natively (scripts/searxng-native.sh or a container):
# WEBDATA_SEARXNG_URL=http://localhost:8888

# Free web-search APIs, combined with SearXNG (any subset works; empty = not used). Keys come from each
# vendor's own sign-up page and stay in backend/.env, never in git. Each is held to its free allowance.
# Keenable's keyless public endpoint is on by default (free, shared); set WEBDATA_KEENABLE_USE_KEY=true to use your key.
WEBDATA_TAVILY_API_KEY=
WEBDATA_LINKUP_API_KEY=
WEBDATA_EXA_API_KEY=
WEBDATA_KEENABLE_API_KEY=

WEBDATA_ENV=development
WEBDATA_SECRET_KEY=CHANGE-ME-long-random-string
# Leave false for http://localhost; set true only behind HTTPS.
WEBDATA_COOKIE_SECURE=false
WEBDATA_CORS_ORIGINS=["http://localhost:5173"]

# Identify your crawler honestly, with a contact URL or email you control.
WEBDATA_USER_AGENT=WebDataAI/0.1 (+mailto:CHANGE-ME@example.com)
WEBDATA_RESPECT_ROBOTS=true
WEBDATA_PER_DOMAIN_DELAY_SECONDS=1.0
WEBDATA_PER_DOMAIN_CONCURRENCY=2

# Platform limits (organizations can only be lowered below these).
WEBDATA_MAX_PAGES_PER_JOB=2000
WEBDATA_MAX_DEPTH=3
WEBDATA_MAX_ACTIVE_JOBS_PER_ORG=3
WEBDATA_MAX_PAGES_PER_ORG_MONTH=50000
WEBDATA_EXPORT_TTL_HOURS=24
WEBDATA_RETENTION_DAYS=90

# Private hosts the crawler may reach, as host:port (empty = none). Only for local test sites.
WEBDATA_ALLOW_PRIVATE_TARGETS=[]

# OpenRouter key for FREE models only (the app never calls a paid model). Leave empty for no model calls.
# Check it with:  python -m app.cli llm-status   and   python -m app.cli llm-test
# WEBDATA_OPENROUTER_API_KEY=CHANGE-ME-sk-or-key
# Optional: free model ids to prefer, best first, e.g. ["meta-llama/llama-3.3-70b-instruct:free"]
# WEBDATA_LLM_PREFERRED_MODELS=[]
